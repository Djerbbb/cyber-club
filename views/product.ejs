<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> — CyberClub</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <a href="/" class="logo">🎮 CyberClub</a>
    <ul class="nav-links">
      <li><a href="/">Главная</a></li>
      <li><a href="/catalog" class="active">Каталог</a></li>
      <li><a href="/contacts">Контакты</a></li>
    </ul>
    <div class="auth-buttons">
      <a href="/cart" class="btn btn-cart">Корзина <span class="cart-count" id="cartCount">0</span></a>
      <span class="user-login" id="userLogin"></span>
      <button class="btn btn-login open-login-btn login-trigger">Войти</button>
      <button class="btn btn-register open-register-btn login-trigger">Регистрация</button>
      <button class="btn btn-login" id="logoutBtn" style="display: none;">Выйти</button>
    </div>
  </header>

  <main>
    <div class="product-page">
      <img src="<%= product.image %>" alt="<%= product.name %>">
      <div class="product-info">
        <h2><%= product.name %></h2>
        <div class="product-price"><%= product.price %> руб / час</div>

        <p class="product-stock">В наличии: <strong><%= product.stock %></strong> шт.</p>

        <h3>Характеристики оборудования:</h3>
        <ul class="product-specs">
          <li><strong>Страна-производитель:</strong> <%= product.country %></li>
          <li><strong>Год выпуска:</strong> <%= product.year %></li>
          <li><strong>Модель:</strong> <%= product.model %></li>
        </ul>

        <div class="product-actions">
          <button class="btn btn-register" id="addToCartBtn" data-product-id="<%= product.id %>">В корзину</button>
          <a href="/cart" class="btn btn-outline">Перейти в корзину</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/auth-modals') %>

  <footer>
    <p>&copy; 2026 CyberClub. Компьютерный клуб. Лабораторная работа.</p>
  </footer>

  <script src="/app.js"></script>
</body>
</html>
