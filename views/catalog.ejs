<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Каталог игровых зон — CyberClub</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header>
    <a href="/" class="logo">🎮 CyberClub</a>
    <ul class="nav-links">
      <li><a href="/">Главная</a></li>
      <li><a href="/catalog" class="active">Каталог</a></li>
      <li><a href="/contacts">Контакты</a></li>
      <li><a href="/account">Личный кабинет</a></li>
      <li id="adminNav" hidden><a href="/admin">Админ-панель</a></li>
    </ul>
    <div class="auth-buttons">
      <a href="/cart" class="btn btn-cart">Корзина <span class="cart-count" id="cartCount">0</span></a>
      <span class="user-login" id="userLogin"></span>
      <button class="btn btn-login open-login-btn login-trigger">Войти</button>
      <button class="btn btn-register open-register-btn login-trigger">Регистрация</button>
      <button class="btn btn-login" id="logoutBtn" style="display: none;">Выйти</button>
    </div>
  </header>

  <main>
    <h2 class="catalog-title">Каталог игровых зон</h2>

    <div class="catalog-controls">
      <select id="filterCategory">
        <option value="all">Все категории</option>
        <% categories.forEach(function (category) { %>
        <option value="<%= category.code %>"><%= category.name %></option>
        <% }); %>
      </select>

      <select id="sortProducts">
        <option value="newest">Сначала новые (по умолчанию)</option>
        <option value="price_asc">Сначала дешевые</option>
        <option value="price_desc">Сначала дорогие</option>
        <option value="year">По году оборудования</option>
        <option value="name">По наименованию (А-Я)</option>
      </select>
    </div>

    <div class="zones-list" id="productsContainer"></div>
  </main>

  <%- include('partials/auth-modals') %>

  <footer>
    <p>&copy; 2026 CyberClub. Компьютерный клуб. Лабораторная работа.</p>
  </footer>

  <script src="/app.js"></script>
</body>
</html>